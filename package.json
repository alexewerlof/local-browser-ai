{
	"name": "local-browser-ai",
	"version": "3.0.0",
	"description": "A browser-aware AI chat harness in your sidebar.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/build.js",
		"dev": "node scripts/dev.js",
		"serve": "node scripts/serve.js",
		"e2e": "npm run build && node dev/e2e/run.mjs",
		"e2e:ext": "npm run build && node dev/e2e/extension.mjs",
		"package": "npm run build && node scripts/package.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "vitest run --config dev/bench/vitest.config.ts --reporter=verbose",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"fmt": "prettier --write .",
		"preversion": "npm run typecheck && npm run lint && npm test"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24.15.0"
	},
	"overrides": {
		"katex": "^0.19.1",
		"minimatch": "^11.0.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@types/turndown": "^5.0.6",
		"@vitejs/plugin-react": "^6.2.1",
		"archiver": "^8.0.0",
		"chrome-types": "^0.1.462",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"playwright-core": "^1.65.0",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@ai-sdk/mcp": "^2.0.91",
		"@ai-sdk/openai-compatible": "^3.0.85",
		"@ai-sdk/provider-utils": "^5.0.75",
		"@mozilla/readability": "^0.6.0",
		"@streamdown/code": "^2.0.0",
		"@streamdown/math": "^1.0.3",
		"ai": "^7.0.163",
		"idb": "^8.0.4",
		"lucide-react": "^1.70.0",
		"markdown-it": "^15.0.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"streamdown": "^2.7.1",
		"turndown": "^7.2.5",
		"turndown-plugin-gfm": "^1.0.2",
		"zod": "^4.6.7"
	}
}
