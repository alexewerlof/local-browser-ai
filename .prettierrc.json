{
	"$schema": "https://json.schemastore.org/prettierrc",
	"printWidth": 120,
	"trailingComma": "all",
	"tabWidth": 4,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"proseWrap": "always",
	"overrides": [
		{
			"files": "*.json",
			"options": {
				"tabWidth": 2
			}
		},
		{
			"files": "ontology.yml",
			"options": {
				"proseWrap": "never"
			}
		}
	]
}
